    ) = load_gold_and_folds()

    verify_w23_fold_assignments(fold_df)

    verify_feature_cache_manifest()

    gold_uid_set = set(gold_df[UID_COLUMN].astype(str))

    study_uids = gold_df[UID_COLUMN].astype(str).tolist()

    y_all = gold_df[LABEL_COLUMNS].values.astype(np.int64)

    all_pseudo_audits: List[pd.DataFrame] = []

    all_fold_histories: List[pd.DataFrame] = []

    oof_records: List[
        Dict[
            str,
            Any,
        ]
    ] = []

    epoch_oof_records: List[
        Dict[
            str,
            Any,
        ]
    ] = []

    fold_metric_rows: List[
        Dict[
            str,
            Any,
        ]
    ] = []

    for fold_zero in range(NUM_FOLDS):

        fold = fold_zero + 1

        print("\n")
        print("#" * 88)
        print(f"OUTER IMAGE FOLD {fold}/{NUM_FOLDS}")
        print("#" * 88)

        train_indices = np.where(fold_ids != fold_zero)[0]

        val_indices = np.where(fold_ids == fold_zero)[0]

        train_uids = [study_uids[index] for index in (train_indices)]

        val_uids = [study_uids[index] for index in (val_indices)]

        print(
            "Gold train/validation studies:",
            f"{len(train_uids)} / {len(val_uids)}",
        )

        pseudo_pool, pseudo_audit = load_fold_pseudo_pool(
            fold,
            gold_uid_set,
        )

        if len(pseudo_pool) == 0:

            raise RuntimeError(f"Fold {fold} has zero selected pseudo studies.")

        # Fast cache sanity check: validate every selected pseudo UID
        # has a feature file before training begins.
        missing_feature_uids = [
            uid
            for uid in (pseudo_pool[UID_COLUMN].astype(str))
            if not feature_cache_path(uid).exists()
        ]

        if missing_feature_uids:

            raise RuntimeError(
                f"Fold {fold}: {len(missing_feature_uids)} "
                "pseudo studies lack W3.0 cached features. "
                f"Example: {missing_feature_uids[0]}"
            )

        all_pseudo_audits.append(pseudo_audit)

        pseudo_audit.to_csv(
            RESULT_ROOT / f"fold_{fold}_pseudo_pool_by_label.csv",
            index=False,
        )

        pseudo_pool[
            [
                UID_COLUMN,
                *[f"{label}_target" for label in (LABEL_COLUMNS)],
                *[f"{label}_mask" for label in (LABEL_COLUMNS)],
            ]
        ].to_csv(
            RESULT_ROOT / f"fold_{fold}_selected_pseudo_pool.csv",
            index=False,
        )

        train_y = y_all[train_indices]

        pos_weight = make_pos_weight(train_y)

        gold_train_dataset = GoldCachedDataset(
            train_uids,
            gold_df,
        )

        gold_val_dataset = GoldCachedDataset(
            val_uids,
            gold_df,
        )

        pseudo_dataset = PseudoCachedDataset(pseudo_pool)

        # Match W3.0 construction order for the gold loaders/model.
        gold_train_loader = DataLoader(
            gold_train_dataset,
            batch_size=BATCH_SIZE,
            shuffle=True,
            num_workers=NUM_WORKERS,
            pin_memory=(DEVICE.type == "cuda"),
            collate_fn=collate_cached_studies,
            persistent_workers=(NUM_WORKERS > 0),
        )

        gold_val_loader = DataLoader(
            gold_val_dataset,
            batch_size=BATCH_SIZE,
            shuffle=False,
            num_workers=NUM_WORKERS,
            pin_memory=(DEVICE.type == "cuda"),
            collate_fn=collate_cached_studies,
            persistent_workers=(NUM_WORKERS > 0),
        )

        model = CachedV4MetadataAblationModel(
            metadata_dim=SERIES_META_DIM,
            num_labels=NUM_LABELS,
            align_v4_rng=True,
        ).to(DEVICE)

        optimizer = torch.optim.AdamW(
            [
                parameter
                for parameter in (model.parameters())
                if parameter.requires_grad
            ],
            lr=HEAD_LEARNING_RATE,
            weight_decay=WEIGHT_DECAY,
        )

        scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(
            optimizer,
            T_max=NUM_EPOCHS,
            eta_min=COSINE_ETA_MIN,
        )

        gold_criterion = nn.BCEWithLogitsLoss(pos_weight=pos_weight)

        scaler = (
            torch.amp.GradScaler(
                "cuda",
                enabled=(USE_AMP and DEVICE.type == "cuda"),
            )
            if DEVICE.type == "cuda"
            else None
        )

        # Dedicated pseudo generator prevents pseudo shuffling from
        # consuming the global RNG used by the model/gold loader.
        pseudo_generator = torch.Generator()

        pseudo_generator.manual_seed(100_000 + RANDOM_SEED + fold)

        pseudo_loader = DataLoader(
            pseudo_dataset,
            batch_size=1,
            shuffle=True,
            generator=pseudo_generator,
            num_workers=NUM_WORKERS,
            pin_memory=(DEVICE.type == "cuda"),
            collate_fn=collate_cached_studies,
            persistent_workers=(NUM_WORKERS > 0),
        )

        fold_history: List[
            Dict[
                str,
                Any,
            ]
        ] = []

        fold_epoch_predictions: List[
            Dict[
                str,
                Any,
            ]
        ] = []

        fold_pseudo_unique_seen: set = set()

        for epoch in range(
            1,
            NUM_EPOCHS + 1,
        ):

            train_metrics = train_weak_epoch(
                model,
                gold_train_loader,
                pseudo_loader,
                gold_criterion,
                optimizer,
                scaler,
            )

            (
                val_metrics,
                y_true,
                y_prob,
            ) = evaluate_gold(
                model,
                gold_val_loader,
                gold_criterion,
            )

            scheduler.step()

            current_lr = float(optimizer.param_groups[0]["lr"])

            history_row = {
                "Fold": fold,
                "Epoch": epoch,
                "LearningRate": current_lr,
                "GoldLoss": train_metrics["gold_loss"],
                "PseudoLoss": train_metrics["pseudo_loss"],
                "TotalLoss": train_metrics["total_loss"],
                "GoldSteps": train_metrics["gold_steps"],
                "PseudoStudiesSeenThisEpoch": train_metrics["pseudo_studies_seen"],
                "PseudoSelectedCellsSeenThisEpoch": train_metrics[
                    "pseudo_selected_cells_seen"
                ],
                "ValLoss": val_metrics["loss"],
                "ValMacroAUROC": val_metrics["macro_AUROC"],
                "ValMacroAP": val_metrics["macro_AP"],
                "ValMacroF1": val_metrics["macro_F1"],
            }

            fold_history.append(history_row)

            print(
                f"Fold {fold} "
                f"Epoch {epoch:02d}/{NUM_EPOCHS}: "
                f"gold={history_row['GoldLoss']:.4f} "
                f"pseudo={history_row['PseudoLoss']:.4f} "
                f"total={history_row['TotalLoss']:.4f} "
                f"val_auc={history_row['ValMacroAUROC']:.4f} "
                f"val_ap={history_row['ValMacroAP']:.4f} "
                f"val_f1={history_row['ValMacroF1']:.4f}"
            )

            for row_idx, uid in enumerate(val_uids):

                record: Dict[
                    str,
                    Any,
                ] = {
                    UID_COLUMN: uid,
                    "Fold": fold,
                    "Epoch": epoch,
                }

                for label_idx, label in enumerate(LABEL_COLUMNS):

                    record[f"{label}_true"] = int(
                        y_true[
                            row_idx,
                            label_idx,
                        ]
                    )

                    record[f"{label}_prob"] = float(
                        y_prob[
                            row_idx,
                            label_idx,
                        ]
                    )

                fold_epoch_predictions.append(record)

                epoch_oof_records.append(record)

            if epoch == NUM_EPOCHS:

                atomic_torch_save(
                    {
                        "fold": fold,
                        "epoch": epoch,
                        "model_state_dict": model.state_dict(),
                        "optimizer_state_dict": optimizer.state_dict(),
                        "config": {
                            "experiment": "W3.1_fold_safe_conservative_weak_supervision",
                            "pseudo_lambda": PSEUDO_LAMBDA,
                            "selection_threshold": SELECTION_THRESHOLD,
                            "pseudo_studies_per_gold_step": 1,
                            "pseudo_target": "continuous_probability",
                            "pseudo_loss": "masked_unweighted_soft_BCE",
                            "feature_cache_version": FEATURE_CACHE_VERSION,
                            "num_epochs": NUM_EPOCHS,
                            "learning_rate": HEAD_LEARNING_RATE,
                            "weight_decay": WEIGHT_DECAY,
                            "cosine_eta_min": COSINE_ETA_MIN,
                        },
                    },
                    CHECKPOINT_ROOT / f"fold_{fold}_epoch_{NUM_EPOCHS}.pt",
                )

        fold_history_df = pd.DataFrame(fold_history)

        fold_history_df.to_csv(
            RESULT_ROOT / f"fold_{fold}_history.csv",
            index=False,
        )

        all_fold_histories.append(fold_history_df)

        pd.DataFrame(fold_epoch_predictions).to_csv(
            RESULT_ROOT / f"fold_{fold}_epoch_predictions.csv",
            index=False,
        )

        # Epoch 12 is the pre-specified final model.
        final_epoch_records = [
            record
            for record in (fold_epoch_predictions)
            if int(record["Epoch"]) == NUM_EPOCHS
        ]

        oof_records.extend(
            [
                {key: value for key, value in (record.items()) if key != "Epoch"}
                for record in (final_epoch_records)
            ]
        )

        final_df = pd.DataFrame(final_epoch_records)

        final_metrics_df, final_summary = pooled_oof_metrics(final_df)

        fold_metric_rows.append(
            {
                "Fold": fold,
                "GoldTrainN": len(train_uids),
                "GoldValidationN": len(val_uids),
                "PseudoCandidateStudyN": len(pseudo_dataset),
                "PseudoSelectedCellN": int(
                    sum(
                        pseudo_pool[f"{label}_mask"].astype(bool).sum()
                        for label in (LABEL_COLUMNS)
                    )
                ),
                "FinalMacroAUROC": final_summary["macro_AUROC"],
                "FinalMacroAP": final_summary["macro_AP"],
                "FinalMacroF1": final_summary["macro_F1"],
            }
        )

        print(
            f"Fold {fold} final: "
            f"AUROC={final_summary['macro_AUROC']:.4f} "
            f"AP={final_summary['macro_AP']:.4f} "
            f"F1={final_summary['macro_F1']:.4f}"
        )

        del model
        del optimizer
        del scheduler
        del gold_criterion
        del scaler
        del gold_train_loader
        del gold_val_loader
        del pseudo_loader
        del gold_train_dataset
        del gold_val_dataset
        del pseudo_dataset

        gc.collect()

        if DEVICE.type == "cuda":

            torch.cuda.empty_cache()

    # ========================================================
    # FINAL OOF RESULTS
    # ========================================================

    oof_df = pd.DataFrame(oof_records).sort_values(UID_COLUMN).reset_index(drop=True)

    if len(oof_df) != 58:

        raise RuntimeError(f"Expected 58 final OOF rows, found {len(oof_df)}.")

    oof_df.to_csv(
        RESULT_ROOT / "oof_predictions.csv",
        index=False,
    )

    epoch_oof_df = pd.DataFrame(epoch_oof_records)

    epoch_oof_df.to_csv(
        RESULT_ROOT / "epoch_oof_predictions.csv",
        index=False,
    )

    epoch_rows: List[
        Dict[
            str,
            Any,
        ]
    ] = []

    for epoch in range(
        1,
        NUM_EPOCHS + 1,
    ):

        epoch_df = epoch_oof_df[epoch_oof_df["Epoch"] == epoch].copy()

        if len(epoch_df) != 58:

            raise RuntimeError(
                f"Epoch {epoch}: expected 58 OOF rows, " f"found {len(epoch_df)}."
            )

        _, summary = pooled_oof_metrics(epoch_df)

        epoch_rows.append(
            {
                "Epoch": epoch,
                "OOF_Macro_AUROC": summary["macro_AUROC"],
                "OOF_Macro_AP": summary["macro_AP"],
                "OOF_Macro_F1": summary["macro_F1"],
            }
        )

    epoch_summary_df = pd.DataFrame(epoch_rows)

    epoch_summary_df.to_csv(
        RESULT_ROOT / "epoch_oof_summary.csv",
        index=False,
    )

    per_label_df, final_summary = pooled_oof_metrics(oof_df)

    per_label_df.to_csv(
        RESULT_ROOT / "oof_per_label_metrics.csv",
        index=False,
    )

    pd.DataFrame(fold_metric_rows).to_csv(
        RESULT_ROOT / "fold_metrics.csv",
        index=False,
    )

    pd.concat(
        all_pseudo_audits,
        ignore_index=True,
    ).to_csv(
        RESULT_ROOT / "pseudo_pool_by_fold_label.csv",
        index=False,
    )

    pd.concat(
        all_fold_histories,
        ignore_index=True,
    ).to_csv(
        RESULT_ROOT / "all_fold_history.csv",
        index=False,
    )

    # ========================================================
    # DIRECT CONTROL COMPARISON
    # ========================================================

    baseline = load_w30_baseline_oof()

    (
        delta_per_label_df,
        comparison,
    ) = compare_to_w30(
        oof_df,
        per_label_df,
        final_summary,
        baseline,
    )

    if not delta_per_label_df.empty:

        delta_per_label_df.to_csv(
            RESULT_ROOT / "delta_vs_w3_0_per_label.csv",
            index=False,
        )

    bootstrap = paired_bootstrap_auc_delta(
        oof_df,
        baseline,
    )

    if bootstrap is not None:

        with open(
            RESULT_ROOT / "paired_bootstrap_macro_auc_delta.json",
            "w",
            encoding="utf-8",
        ) as handle:

            json.dump(
                bootstrap,
                handle,
                indent=2,
                allow_nan=True,
            )

    comparison["paired_bootstrap_macro_auc_delta"] = bootstrap

    comparison["runtime_seconds"] = time.time() - started

    with open(
        RESULT_ROOT / "W3_1_COMPARISON.json",
        "w",
        encoding="utf-8",
    ) as handle:

        json.dump(
            comparison,
            handle,
            indent=2,
            allow_nan=True,
        )

    # ========================================================
    # CONFIG / REPORT
    # ========================================================

    config = {
        "experiment": "W3.1 Fold-Safe Conservative Weak Supervision",
        "data_root": str(DATA_ROOT),
        "feature_cache_root": str(FEATURE_CACHE_ROOT),
        "w2_3_root": str(W23_ROOT),
        "output_root": str(WORK_ROOT),
        "feature_cache_version": FEATURE_CACHE_VERSION,
        "num_folds": NUM_FOLDS,
        "fold_sha256": EXPECTED_V4_FOLD_SHA256,
        "num_epochs": NUM_EPOCHS,
        "batch_size_gold": 1,
        "batch_size_pseudo": 1,
        "pseudo_studies_per_gold_step": 1,
        "pseudo_lambda": PSEUDO_LAMBDA,
        "selection_threshold": SELECTION_THRESHOLD,
        "pseudo_mask": (
            "W2.3 SoftLabelAvailable AND "
            "CandidateSelectionScore >= threshold AND "
            "soft probability is not null"
        ),
        "pseudo_target": "continuous W2.3 fold-specific probability",
        "pseudo_loss": (
            "unweighted BCEWithLogits, reduction none, "
            "masked and normalized over selected cells only"
        ),
        "candidate_selection_score_used_as_loss_weight": False,
        "pseudo_class_pos_weight": False,
        "gold_loss": (
            "BCEWithLogitsLoss with fold-train neg/pos " "pos_weight clipped [1,5]"
        ),
        "optimizer": "AdamW",
        "learning_rate": HEAD_LEARNING_RATE,
        "weight_decay": WEIGHT_DECAY,
        "scheduler": "CosineAnnealingLR",
        "cosine_eta_min": COSINE_ETA_MIN,
        "early_stopping": False,
        "amp": USE_AMP,
        "labels": LABEL_COLUMNS,
    }

    with open(
        RESULT_ROOT / "w3_1_config.json",
        "w",
        encoding="utf-8",
    ) as handle:

        json.dump(
            config,
            handle,
            indent=2,
        )

    delta_ref = final_summary["macro_AUROC"] - W30_REFERENCE_MACRO_AUROC

    if "delta_w3_1_minus_w3_0_oof" in comparison:

        delta_exact = comparison["delta_w3_1_minus_w3_0_oof"]["macro_AUROC"]

    else:

        delta_exact = delta_ref

    if delta_exact >= 0.02:

        practical_result = "STRONG_SUCCESS"

    elif delta_exact >= 0.005:

        practical_result = "USEFUL_SIGNAL"

    elif delta_exact > -0.005:

        practical_result = "NEAR_ZERO"

    else:

        practical_result = "NEGATIVE"

    report_lines = [
        "# W3.1 Fold-Safe Conservative Weak Supervision",
        "",
        "## Final endpoint",
        "",
        f"- W3.1 macro OOF AUROC: {final_summary['macro_AUROC']:.6f}",
        f"- W3.1 macro OOF AP: {final_summary['macro_AP']:.6f}",
        f"- W3.1 macro OOF F1: {final_summary['macro_F1']:.6f}",
        f"- W3.0 reference AUROC: {W30_REFERENCE_MACRO_AUROC:.6f}",
        f"- Delta AUROC: {delta_exact:+.6f}",
        f"- Practical result bucket: {practical_result}",
        "",
        "## Fixed intervention",
        "",
        f"- Pseudo lambda: {PSEUDO_LAMBDA}",
        f"- Selection threshold: {SELECTION_THRESHOLD}",
        "- One pseudo study per gold optimizer step.",
        "- Soft targets remain continuous probabilities.",
        "- Pseudo BCE is masked to selected cells only.",
        "- CandidateSelectionScore is NOT a loss weight.",
        "- No pseudo positive-class weighting is applied.",
        "- Epoch length is defined by the gold loader.",
        "",
        "## Leakage controls",
        "",
        "- Outer image fold k consumes only W2.3 fold_k pseudo outputs.",
        "- W2.3 fold assignment file is required to match V4/W3.0 exactly.",
        "- No cross-fold probability stability file is used.",
        "- No all-58 W2 soft probabilities/calibrators are used.",
        "",
        "## Interpretation caution",
        "",
        "- n=58 gold studies makes OOF deltas noisy.",
        "- Epoch 12 is the pre-specified endpoint; no validation-driven epoch selection.",
        "- Bootstrap output, when present, is descriptive rather than an independent significance test.",
    ]

    if bootstrap is not None:

        report_lines.extend(
            [
                "",
                "## Paired descriptive bootstrap",
                "",
                f"- 95% CI delta macro AUROC: "
                f"[{bootstrap['ci95_low']:+.6f}, "
                f"{bootstrap['ci95_high']:+.6f}]",
                f"- Bootstrap P(delta>0): "
                f"{bootstrap['probability_delta_gt_0']:.3f}",
            ]
        )

    with open(
        RESULT_ROOT / "W3_1_REPORT.md",
        "w",
        encoding="utf-8",
    ) as handle:

        handle.write("\n".join(report_lines) + "\n")

    # ========================================================
    # CONSOLE DECISION SUMMARY
    # ========================================================

    print("\n")
    print("=" * 88)
    print("W3.1 COMPLETE")
    print("=" * 88)

    print("\nEpoch-wise pooled OOF:")
    print(epoch_summary_df.to_string(index=False))

    print("\nFinal pooled OOF:")
    print(f"  W3.1 AUROC : " f"{final_summary['macro_AUROC']:.6f}")
    print(f"  W3.0 AUROC : " f"{W30_REFERENCE_MACRO_AUROC:.6f}")
    print(f"  Delta      : " f"{delta_exact:+.6f}")
    print(f"  W3.1 AP    : " f"{final_summary['macro_AP']:.6f}")
    print(f"  W3.1 F1    : " f"{final_summary['macro_F1']:.6f}")

    print(f"\nPractical result: " f"{practical_result}")

    if bootstrap is not None:

        print(
            "\nPaired descriptive bootstrap " f"({bootstrap['repeats_valid']} valid):"
        )

        print(
            "  delta AUROC 95% CI: "
            f"[{bootstrap['ci95_low']:+.6f}, "
            f"{bootstrap['ci95_high']:+.6f}]"
        )

        print("  P(delta > 0): " f"{bootstrap['probability_delta_gt_0']:.3f}")

    if not delta_per_label_df.empty:

        print("\nPer-label AUROC delta vs W3.0:")

        print(
            delta_per_label_df[
                [
                    "Label",
                    "W3_0_AUROC",
                    "W3_1_AUROC",
                    "Delta_AUROC",
                ]
            ].to_string(index=False)
        )

    print("\nResults directory:")
    print(RESULT_ROOT)

    print("\nRuntime:" f" {elapsed_string(time.time() - started)}")


if __name__ == "__main__":

    run_w31()
