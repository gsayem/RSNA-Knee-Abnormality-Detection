    ):

        self.study_uids = [str(uid) for uid in (study_uids)]

        self.gold = gold_df.set_index(UID_COLUMN)

    def __len__(
        self,
    ) -> int:

        return len(self.study_uids)

    def __getitem__(
        self,
        index: int,
    ) -> Dict[
        str,
        Any,
    ]:

        uid = self.study_uids[index]

        features = load_cached_features(uid)

        labels = torch.tensor(
            self.gold.loc[
                uid,
                LABEL_COLUMNS,
            ].values.astype(np.float32),
            dtype=torch.float32,
        )

        return {
            "study_uid": uid,
            "features": features,
            "labels": labels,
        }


class PseudoCachedDataset(Dataset):
    def __init__(
        self,
        pool: pd.DataFrame,
    ):

        self.pool = pool.reset_index(drop=True).copy()

    def __len__(
        self,
    ) -> int:

        return len(self.pool)

    def __getitem__(
        self,
        index: int,
    ) -> Dict[
        str,
        Any,
    ]:

        row = self.pool.iloc[index]

        uid = str(row[UID_COLUMN])

        features = load_cached_features(uid)

        targets = np.asarray(
            [float(row[f"{label}_target"]) for label in (LABEL_COLUMNS)],
            dtype=np.float32,
        )

        mask = np.asarray(
            [bool(row[f"{label}_mask"]) for label in (LABEL_COLUMNS)],
            dtype=np.bool_,
        )

        if not mask.any():

            raise RuntimeError(
                "Pseudo dataset contains a study with " f"no selected labels: {uid}"
            )

        return {
            "study_uid": uid,
            "features": features,
            "targets": torch.from_numpy(targets),
            "target_mask": torch.from_numpy(mask),
        }


def collate_cached_studies(
    batch: List[
        Dict[
            str,
            Any,
        ]
    ],
) -> Dict[
    str,
    Any,
]:

    b = len(batch)

    max_series = max(item["features"].shape[0] for item in (batch))

    features = torch.zeros(
        b,
        max_series,
        SLICES_PER_SERIES,
        FEATURE_DIM,
        dtype=torch.float32,
    )

    metadata = torch.zeros(
        b,
        max_series,
        SERIES_META_DIM,
        dtype=torch.float32,
    )

    series_mask = torch.zeros(
        b,
        max_series,
        dtype=torch.bool,
    )

    study_uids: List[str] = []

    for i, item in enumerate(batch):

        s = item["features"].shape[0]

        features[
            i,
            :s,
        ] = item["features"]

        series_mask[
            i,
            :s,
        ] = True

        study_uids.append(item["study_uid"])

    output: Dict[
        str,
        Any,
    ] = {
        "study_uid": study_uids,
        "features": features,
        "metadata": metadata,
        "series_mask": series_mask,
    }

    if "labels" in batch[0]:

        output["labels"] = torch.stack([item["labels"] for item in (batch)])

    if "targets" in batch[0]:

        output["targets"] = torch.stack([item["targets"] for item in (batch)])

        output["target_mask"] = torch.stack([item["target_mask"] for item in (batch)])

    return output


# ============================================================
# 8. EXACT W3.0/V4 TRAINABLE MODEL
# ============================================================


class SliceAttention(nn.Module):
    def __init__(
        self,
        embedding_dim: int,
    ):

        super().__init__()

        hidden = max(
            64,
            embedding_dim // 2,
        )

        self.score = nn.Sequential(
            nn.Linear(
                embedding_dim,
                hidden,
            ),
            nn.Tanh(),
            nn.Linear(
                hidden,
                1,
            ),
        )

    def forward(
        self,
        x: torch.Tensor,
    ) -> Tuple[
        torch.Tensor,
        torch.Tensor,
    ]:

        scores = self.score(x).squeeze(-1)

        attention = torch.softmax(
            scores,
            dim=1,
        )

        pooled = torch.sum(
            x * attention.unsqueeze(-1),
            dim=1,
        )

        return (
            pooled,
            attention,
        )


class SeriesAttention(nn.Module):
    def __init__(
        self,
        embedding_dim: int,
    ):

        super().__init__()

        hidden = max(
            64,
            embedding_dim // 2,
        )

        self.score = nn.Sequential(
            nn.Linear(
                embedding_dim,
                hidden,
            ),
            nn.Tanh(),
            nn.Linear(
                hidden,
                1,
            ),
        )

    def forward(
        self,
        x: torch.Tensor,
        mask: torch.Tensor,
    ) -> Tuple[
        torch.Tensor,
        torch.Tensor,
    ]:

        scores = self.score(x).squeeze(-1)

        scores = scores.float()

        scores = scores.masked_fill(
            ~mask,
            torch.finfo(scores.dtype).min,
        )

        attention = torch.softmax(
            scores,
            dim=1,
        )

        pooled = torch.sum(
            x * attention.unsqueeze(-1),
            dim=1,
        )

        return (
            pooled,
            attention,
        )


def consume_v4_backbone_initialization_rng() -> None:
    """
    Match W3.0's RNG alignment: V4 constructed ResNet18 before
    constructing the trainable attention head.
    """

    dummy = resnet18(weights=None)

    del dummy


class CachedV4MetadataAblationModel(nn.Module):
    def __init__(
        self,
        metadata_dim: int,
        num_labels: int,
        align_v4_rng: bool = True,
    ):

        super().__init__()

        if align_v4_rng:

            consume_v4_backbone_initialization_rng()

        visual_dim = FEATURE_DIM

        self.embedding_dim = 256

        self.visual_projection = nn.Sequential(
            nn.Linear(
                visual_dim,
                self.embedding_dim,
            ),
            nn.LayerNorm(self.embedding_dim),
            nn.GELU(),
        )

        self.metadata_projection = nn.Sequential(
            nn.Linear(
                metadata_dim,
                64,
            ),
            nn.LayerNorm(64),
            nn.GELU(),
            nn.Linear(
                64,
                128,
            ),
            nn.GELU(),
        )

        self.series_fusion = nn.Sequential(
            nn.Linear(
                self.embedding_dim + 128,
                self.embedding_dim,
            ),
            nn.LayerNorm(self.embedding_dim),
            nn.GELU(),
            nn.Dropout(0.10),
        )

        self.slice_attention = SliceAttention(self.embedding_dim)

        self.series_attention = SeriesAttention(self.embedding_dim)

        self.classifier = nn.Sequential(
            nn.LayerNorm(self.embedding_dim),
            nn.Dropout(0.15),
            nn.Linear(
                self.embedding_dim,
                num_labels,
            ),
        )

    def forward(
        self,
        features: torch.Tensor,
        metadata: torch.Tensor,
        series_mask: torch.Tensor,
    ) -> Dict[
        str,
        torch.Tensor,
    ]:

        b, s, k, d = features.shape

        flat_features = features.reshape(
            b * s * k,
            d,
        )

        flat_features = self.visual_projection(flat_features)

        slice_features = flat_features.reshape(
            b * s,
            k,
            self.embedding_dim,
        )

        (
            series_visual,
            slice_attention,
        ) = self.slice_attention(slice_features)

        series_visual = series_visual.reshape(
            b,
            s,
            self.embedding_dim,
        )

        slice_attention = slice_attention.reshape(
            b,
            s,
            k,
        )

        if USE_SERIES_METADATA:

            metadata_input = metadata

        else:

            metadata_input = torch.zeros_like(metadata)

        metadata_features = self.metadata_projection(metadata_input)

        combined = torch.cat(
            [
                series_visual,
                metadata_features,
            ],
            dim=-1,
        )

        series_features = self.series_fusion(combined)

        (
            study_embedding,
            series_attention,
        ) = self.series_attention(
            series_features,
            series_mask,
        )

        logits = self.classifier(study_embedding)

        return {
            "logits": logits,
            "study_embedding": study_embedding,
            "slice_attention": slice_attention,
            "series_attention": series_attention,
        }


# ============================================================
# 9. LOSSES / METRICS
# ============================================================


def make_pos_weight(
    y_train: np.ndarray,
) -> torch.Tensor:

    positive = y_train.sum(axis=0)

    negative = y_train.shape[0] - positive

    weights = negative / np.maximum(
        positive,
        1,
    )

    weights = np.clip(
        weights,
        1.0,
        5.0,
    )

    return torch.tensor(
        weights,
        dtype=torch.float32,
        device=DEVICE,
    )


def masked_soft_bce(
    logits: torch.Tensor,
    targets: torch.Tensor,
    mask: torch.Tensor,
) -> Tuple[
    torch.Tensor,
    int,
]:

    per_cell = F.binary_cross_entropy_with_logits(
        logits.float(),
        targets.float(),
        reduction="none",
    )

    mask_float = mask.float()

    selected_n = int(mask_float.sum().detach().cpu().item())

    if selected_n <= 0:

        raise RuntimeError("Pseudo batch contains no selected target cells.")

    loss = (per_cell * mask_float).sum() / mask_float.sum().clamp_min(1.0)

    return (
        loss,
        selected_n,
    )


def metric_summary(
    y_true: np.ndarray,
    y_prob: np.ndarray,
) -> Dict[
    str,
    float,
]:

    metrics: Dict[
        str,
        float,
    ] = {}

    aucs: List[float] = []

    aps: List[float] = []

    for idx, label in enumerate(LABEL_COLUMNS):

        auc = safe_auc(
            y_true[
                :,
                idx,
            ],
            y_prob[
                :,
                idx,
            ],
        )

        ap = safe_ap(
            y_true[
                :,
                idx,
            ],
            y_prob[
                :,
                idx,
            ],
        )

        metrics[f"{label}_AUROC"] = auc

        metrics[f"{label}_AP"] = ap

        if np.isfinite(auc):

            aucs.append(auc)

        if np.isfinite(ap):

            aps.append(ap)

    metrics["macro_AUROC"] = float(np.mean(aucs)) if aucs else float("nan")

    metrics["macro_AP"] = float(np.mean(aps)) if aps else float("nan")

    y_pred = (y_prob >= 0.5).astype(np.int32)

    metrics["macro_F1"] = float(
        f1_score(
            y_true,
            y_pred,
            average="macro",
            zero_division=0,
        )
    )

    return metrics


# ============================================================
# 10. TRAIN / VALIDATE
# ============================================================


def to_device(
    batch: Dict[
        str,
        Any,
    ],
) -> Dict[
    str,
    Any,
]:

    output = dict(batch)

    for key in [
        "features",
        "metadata",
        "series_mask",
        "labels",
        "targets",
        "target_mask",
    ]:

        if key in output and isinstance(
            output[key],
            torch.Tensor,
        ):

            output[key] = output[key].to(
                DEVICE,
                non_blocking=True,
            )

    return output


def train_weak_epoch(
    model: nn.Module,
    gold_loader: DataLoader,
    pseudo_loader: DataLoader,
    gold_criterion: nn.Module,
    optimizer: torch.optim.Optimizer,
    scaler: Optional[torch.amp.GradScaler],
) -> Dict[
    str,
    Any,
]:

    model.train()

    pseudo_iterator = iter(pseudo_loader)

    total_gold_loss = 0.0
    total_pseudo_loss = 0.0
    total_loss = 0.0

    gold_steps = 0
    pseudo_selected_cells = 0

    pseudo_seen_uids: set = set()

    for gold_batch in gold_loader:

        gold_batch = to_device(gold_batch)

        try:

            pseudo_batch = next(pseudo_iterator)

        except StopIteration:

            pseudo_iterator = iter(pseudo_loader)

            pseudo_batch = next(pseudo_iterator)

        pseudo_seen_uids.update(pseudo_batch["study_uid"])

        pseudo_batch = to_device(pseudo_batch)

        optimizer.zero_grad(set_to_none=True)

        with autocast_context():

            gold_outputs = model(
                gold_batch["features"],
                gold_batch["metadata"],
                gold_batch["series_mask"],
            )

            gold_loss = gold_criterion(
                gold_outputs["logits"],
                gold_batch["labels"],
            )

            pseudo_outputs = model(
                pseudo_batch["features"],
                pseudo_batch["metadata"],
                pseudo_batch["series_mask"],
            )

            (
                pseudo_loss,
                selected_n,
            ) = masked_soft_bce(
                pseudo_outputs["logits"],
                pseudo_batch["targets"],
                pseudo_batch["target_mask"],
            )

            loss = gold_loss + PSEUDO_LAMBDA * pseudo_loss

        if scaler is not None:

            scaler.scale(loss).backward()

            scaler.step(optimizer)

            scaler.update()

        else:

            loss.backward()

            optimizer.step()

        total_gold_loss += float(gold_loss.detach().cpu().item())

        total_pseudo_loss += float(pseudo_loss.detach().cpu().item())

        total_loss += float(loss.detach().cpu().item())

        pseudo_selected_cells += selected_n

        gold_steps += 1

    return {
        "gold_loss": total_gold_loss
        / max(
            gold_steps,
            1,
        ),
        "pseudo_loss": total_pseudo_loss
        / max(
            gold_steps,
            1,
        ),
        "total_loss": total_loss
        / max(
            gold_steps,
            1,
        ),
        "gold_steps": gold_steps,
        "pseudo_studies_seen": len(pseudo_seen_uids),
        "pseudo_selected_cells_seen": pseudo_selected_cells,
    }


@torch.no_grad()
def evaluate_gold(
    model: nn.Module,
    loader: DataLoader,
    criterion: nn.Module,
) -> Tuple[
    Dict[
        str,
        float,
    ],
    np.ndarray,
    np.ndarray,
]:

    model.eval()

    total_loss = 0.0
    total_samples = 0

    targets: List[np.ndarray] = []

    probabilities: List[np.ndarray] = []

    for batch in loader:

        batch = to_device(batch)

        with autocast_context():

            outputs = model(
                batch["features"],
                batch["metadata"],
                batch["series_mask"],
            )

            logits = outputs["logits"]

            loss = criterion(
                logits,
                batch["labels"],
            )

        batch_size = batch["labels"].shape[0]

        total_loss += float(loss.detach().cpu().item()) * batch_size

        total_samples += batch_size

        targets.append(batch["labels"].detach().cpu().numpy())

        probabilities.append(torch.sigmoid(logits).detach().cpu().numpy())

    y_true = np.concatenate(
        targets,
        axis=0,
    )

    y_prob = np.concatenate(
        probabilities,
        axis=0,
    )

    metrics = metric_summary(
        y_true,
        y_prob,
    )

    metrics["loss"] = total_loss / max(
        total_samples,
        1,
    )

    return (
        metrics,
        y_true,
        y_prob,
    )


