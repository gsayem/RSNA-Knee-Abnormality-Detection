def safe_auc(
    y_true: np.ndarray,
    y_score: np.ndarray,
) -> float:

    try:

        if len(np.unique(y_true)) < 2:

            return float("nan")

        return float(
            roc_auc_score(
                y_true,
                y_score,
            )
        )

    except Exception:

        return float("nan")


