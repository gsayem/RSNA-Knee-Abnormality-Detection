def pooled_oof_metrics(
    oof_df: pd.DataFrame,
) -> Tuple[
    pd.DataFrame,
    Dict[
        str,
        float,
    ],
]:

    rows: List[
        Dict[
            str,
            Any,
        ]
    ] = []

    y_true_matrix: List[np.ndarray] = []

    y_prob_matrix: List[np.ndarray] = []

    aucs: List[float] = []

    aps: List[float] = []

    for label in LABEL_COLUMNS:

        y_true = oof_df[f"{label}_true"].values.astype(np.int64)

        y_prob = oof_df[f"{label}_prob"].values.astype(np.float64)

        auc = safe_auc(
            y_true,
            y_prob,
        )

        ap = safe_ap(
            y_true,
            y_prob,
        )

        rows.append(
            {
                "Label": label,
                "PositiveCount": int(y_true.sum()),
                "AUROC": auc,
                "AveragePrecision": ap,
            }
        )

        if np.isfinite(auc):
            aucs.append(auc)

        if np.isfinite(ap):
            aps.append(ap)

        y_true_matrix.append(y_true)

        y_prob_matrix.append(y_prob)

    y_true_full = np.stack(
        y_true_matrix,
        axis=1,
    )

    y_prob_full = np.stack(
        y_prob_matrix,
        axis=1,
    )

    y_pred_full = (y_prob_full >= 0.5).astype(np.int32)

    summary = {
        "macro_AUROC": float(np.mean(aucs)),
        "macro_AP": float(np.mean(aps)),
        "macro_F1": float(
            f1_score(
                y_true_full,
                y_pred_full,
                average="macro",
                zero_division=0,
            )
        ),
    }

    return (
        pd.DataFrame(rows),
        summary,
    )


def load_w30_baseline_oof() -> Optional[pd.DataFrame]:

    path = W30_RESULTS_ROOT / "oof_predictions.csv"

    if not path.exists():

        print(
            "WARNING: W3.0 oof_predictions.csv not found. "
            "Only fixed reference metrics will be used."
        )

        return None

    baseline = pd.read_csv(path)

    baseline[UID_COLUMN] = baseline[UID_COLUMN].astype(str)

    return baseline


def compare_to_w30(
    w31_oof: pd.DataFrame,
    w31_per_label: pd.DataFrame,
    w31_summary: Dict[
        str,
        float,
    ],
    baseline: Optional[pd.DataFrame],
) -> Tuple[
    pd.DataFrame,
    Dict[
        str,
        Any,
    ],
]:

    rows: List[
        Dict[
            str,
            Any,
        ]
    ] = []

    reference_summary = {
        "macro_AUROC": W30_REFERENCE_MACRO_AUROC,
        "macro_AP": W30_REFERENCE_MACRO_AP,
        "macro_F1": W30_REFERENCE_MACRO_F1,
    }

    comparison: Dict[
        str,
        Any,
    ] = {
        "w3_0_reference": reference_summary,
        "w3_1": w31_summary,
        "delta_w3_1_minus_w3_0_reference": {
            metric: float(w31_summary[metric] - reference_summary[metric])
            for metric in [
                "macro_AUROC",
                "macro_AP",
                "macro_F1",
            ]
        },
    }

    if baseline is None:

        return (
            pd.DataFrame(rows),
            comparison,
        )

    left = w31_oof.sort_values(UID_COLUMN).reset_index(drop=True)

    right = baseline.sort_values(UID_COLUMN).reset_index(drop=True)

    if left[UID_COLUMN].tolist() != right[UID_COLUMN].tolist():

        raise RuntimeError("W3.0 and W3.1 OOF UID mismatch.")

    if "Fold" in right.columns and not np.array_equal(
        left["Fold"].values,
        right["Fold"].values,
    ):

        raise RuntimeError("W3.0 and W3.1 OOF fold mismatch.")

    for label in LABEL_COLUMNS:

        y_true = left[f"{label}_true"].values

        weak_prob = left[f"{label}_prob"].values

        baseline_prob = right[f"{label}_prob"].values

        weak_auc = safe_auc(
            y_true,
            weak_prob,
        )

        baseline_auc = safe_auc(
            y_true,
            baseline_prob,
        )

        weak_ap = safe_ap(
            y_true,
            weak_prob,
        )

        baseline_ap = safe_ap(
            y_true,
            baseline_prob,
        )

        rows.append(
            {
                "Label": label,
                "W3_0_AUROC": baseline_auc,
                "W3_1_AUROC": weak_auc,
                "Delta_AUROC": weak_auc - baseline_auc,
                "W3_0_AP": baseline_ap,
                "W3_1_AP": weak_ap,
                "Delta_AP": weak_ap - baseline_ap,
            }
        )

    baseline_per_label, baseline_summary = pooled_oof_metrics(right)

    comparison["w3_0_from_attached_oof"] = baseline_summary

    comparison["delta_w3_1_minus_w3_0_oof"] = {
        metric: float(w31_summary[metric] - baseline_summary[metric])
        for metric in [
            "macro_AUROC",
            "macro_AP",
            "macro_F1",
        ]
    }

    return (
        pd.DataFrame(rows),
        comparison,
    )


def paired_bootstrap_auc_delta(
    w31_oof: pd.DataFrame,
    baseline: Optional[pd.DataFrame],
) -> Optional[
    Dict[
        str,
        Any,
    ]
]:

    if baseline is None or BOOTSTRAP_REPEATS <= 0:

        return None

    weak = w31_oof.sort_values(UID_COLUMN).reset_index(drop=True)

    base = baseline.sort_values(UID_COLUMN).reset_index(drop=True)

    n = len(weak)

    rng = np.random.default_rng(BOOTSTRAP_SEED)

    deltas: List[float] = []

    for _ in range(BOOTSTRAP_REPEATS):

        indices = rng.integers(
            0,
            n,
            size=n,
        )

        weak_aucs: List[float] = []

        base_aucs: List[float] = []

        for label in LABEL_COLUMNS:

            y = weak[f"{label}_true"].values[indices]

            if len(np.unique(y)) < 2:

                continue

            weak_auc = safe_auc(
                y,
                weak[f"{label}_prob"].values[indices],
            )

            base_auc = safe_auc(
                y,
                base[f"{label}_prob"].values[indices],
            )

            if np.isfinite(weak_auc) and np.isfinite(base_auc):

                weak_aucs.append(weak_auc)

                base_aucs.append(base_auc)

        if weak_aucs:

            deltas.append(float(np.mean(weak_aucs) - np.mean(base_aucs)))

    if not deltas:

        return None

    values = np.asarray(
        deltas,
        dtype=np.float64,
    )

    return {
        "method": "paired_study_bootstrap_descriptive",
        "repeats_requested": BOOTSTRAP_REPEATS,
        "repeats_valid": int(len(values)),
        "mean_delta_macro_AUROC": float(np.mean(values)),
        "median_delta_macro_AUROC": float(np.median(values)),
        "ci95_low": float(
            np.quantile(
                values,
                0.025,
            )
        ),
        "ci95_high": float(
            np.quantile(
                values,
                0.975,
            )
        ),
        "probability_delta_gt_0": float(np.mean(values > 0)),
        "warning": (
            "Descriptive only. n=58 and the same research cohort "
            "was used throughout method development."
        ),
    }


