def _read_w23_wide(
    fold: int,
    filename: str,
) -> pd.DataFrame:

    path = W23_ROOT / "folds" / f"fold_{fold}" / filename

    if not path.exists():

        raise FileNotFoundError(path)

    df = pd.read_csv(path)

    if UID_COLUMN not in (df.columns):

        raise RuntimeError(f"{path} has no {UID_COLUMN} column.")

    df[UID_COLUMN] = df[UID_COLUMN].astype(str)

    missing = [label for label in (LABEL_COLUMNS) if label not in (df.columns)]

    if missing:

        raise RuntimeError(f"{path} missing labels: {missing}")

    if df[UID_COLUMN].duplicated().any():

        raise RuntimeError(f"Duplicate study UIDs in {path}")

    return df


def load_fold_pseudo_pool(
    fold: int,
    gold_uid_set: set,
) -> Tuple[
    pd.DataFrame,
    pd.DataFrame,
]:

    probability_df = _read_w23_wide(
        fold,
        "soft_probabilities_wide.csv",
    )

    availability_df = _read_w23_wide(
        fold,
        "soft_label_availability_wide.csv",
    )

    selection_df = _read_w23_wide(
        fold,
        "candidate_selection_scores_wide.csv",
    )

    if not (
        probability_df[UID_COLUMN].tolist()
        == availability_df[UID_COLUMN].tolist()
        == selection_df[UID_COLUMN].tolist()
    ):

        raise RuntimeError(
            f"W2.3 fold {fold} wide files have " "different UID ordering/content."
        )

    uids = probability_df[UID_COLUMN].astype(str)

    gold_overlap = set(uids) & gold_uid_set

    if gold_overlap:

        raise RuntimeError(
            "W2.3 pseudo pool contains gold studies. "
            f"Examples: {sorted(gold_overlap)[:3]}"
        )

    if len(probability_df) != 4349:

        print(
            f"WARNING: fold {fold} expected 4,349 "
            f"unlabeled studies, found {len(probability_df)}."
        )

    probability = probability_df[LABEL_COLUMNS].apply(
        pd.to_numeric,
        errors="coerce",
    )

    selection = (
        selection_df[LABEL_COLUMNS]
        .apply(
            pd.to_numeric,
            errors="coerce",
        )
        .fillna(0.0)
    )

    availability = pd.DataFrame(index=availability_df.index)

    for label in LABEL_COLUMNS:

        availability[label] = coerce_bool_series(availability_df[label])

    # Pre-specified W3.1 selection rule:
    # available AND selection score >= 0.5 AND probability exists.
    mask = (
        availability[LABEL_COLUMNS]
        & (selection[LABEL_COLUMNS] >= SELECTION_THRESHOLD)
        & probability[LABEL_COLUMNS].notna()
    )

    # If the exact W2.3 high-selection file is present and we are
    # using its original threshold 0.5, verify our reconstruction.
    high_mask_path = (
        W23_ROOT / "folds" / f"fold_{fold}" / "high_selection_candidate_mask_wide.csv"
    )

    if high_mask_path.exists() and abs(SELECTION_THRESHOLD - 0.50) < 1e-12:

        high_df = pd.read_csv(high_mask_path)

        high_df[UID_COLUMN] = high_df[UID_COLUMN].astype(str)

        if high_df[UID_COLUMN].tolist() != uids.tolist():

            raise RuntimeError("W2.3 high-selection mask UID mismatch.")

        high_bool = pd.DataFrame(index=high_df.index)

        for label in LABEL_COLUMNS:

            high_bool[label] = coerce_bool_series(high_df[label])

        if not np.array_equal(
            mask[LABEL_COLUMNS].values,
            high_bool[LABEL_COLUMNS].values,
        ):

            raise RuntimeError(
                f"Fold {fold}: reconstructed selection "
                "mask does not equal W2.3 high-selection mask."
            )

    candidate_any = mask[LABEL_COLUMNS].any(axis=1)

    candidate_uids = uids[candidate_any].reset_index(drop=True)

    candidate_probability = probability.loc[
        candidate_any,
        LABEL_COLUMNS,
    ].reset_index(drop=True)

    candidate_mask = mask.loc[
        candidate_any,
        LABEL_COLUMNS,
    ].reset_index(drop=True)

    candidate_selection = selection.loc[
        candidate_any,
        LABEL_COLUMNS,
    ].reset_index(drop=True)

    pool = pd.DataFrame({UID_COLUMN: candidate_uids})

    for label in LABEL_COLUMNS:

        # Values outside the mask are never used by the loss.
        pool[f"{label}_target"] = (
            candidate_probability[label].fillna(0.5).astype(np.float32)
        )

        pool[f"{label}_mask"] = candidate_mask[label].astype(bool)

        pool[f"{label}_selection"] = candidate_selection[label].astype(np.float32)

    # --------------------------------------------------------
    # Audit by label
    # --------------------------------------------------------

    rows: List[
        Dict[
            str,
            Any,
        ]
    ] = []

    for label in LABEL_COLUMNS:

        selected = candidate_mask[label].values.astype(bool)

        selected_n = int(selected.sum())

        if selected_n > 0:

            targets = candidate_probability.loc[
                selected,
                label,
            ].values.astype(np.float64)

            selected_scores = candidate_selection.loc[
                selected,
                label,
            ].values.astype(np.float64)

            target_mean = float(np.mean(targets))

            target_positive_fraction = float(np.mean(targets >= 0.5))

            score_mean = float(np.mean(selected_scores))

        else:

            target_mean = float("nan")

            target_positive_fraction = float("nan")

            score_mean = float("nan")

        rows.append(
            {
                "OuterFold": fold,
                "Label": label,
                "SelectedCellN": selected_n,
                "SelectedStudyCoverage": selected_n
                / max(
                    len(probability_df),
                    1,
                ),
                "MeanSoftTarget": target_mean,
                "SoftTargetFraction_ge_0_5": target_positive_fraction,
                "MeanSelectionScore": score_mean,
            }
        )

    audit_df = pd.DataFrame(rows)

    expected_candidate_studies = int(candidate_any.sum())

    expected_cells = int(candidate_mask[LABEL_COLUMNS].values.sum())

    print(
        f"Fold {fold} W2.3 high-selection pool: "
        f"{expected_candidate_studies} studies, "
        f"{expected_cells} selected cells"
    )

    return (
        pool,
        audit_df,
    )


